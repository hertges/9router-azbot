# Get API_ID / API_HASH from https://my.telegram.org/apps
# Pyrogram needs these even for a bot account — they're what let it talk
# to Telegram's MTProto layer directly instead of the HTTP Bot API, which
# is what removes the 50MB upload limit.
API_ID=
API_HASH=

# From @BotFather
BOT_TOKEN=

# Your numeric Telegram user ID. If set, only this ID (and anyone you
# /allow) can use the bot. Leave blank to let anyone use it.
ADMIN_ID=

# Optional: Google Drive as a secondary/alternate destination.
# SINGLE account (backwards compatible):
GCP_CLIENT_ID=
GCP_CLIENT_SECRET=
GCP_REFRESH_TOKEN=
# MULTIPLE accounts — repeat blocks like this (name after GDrive_ is free):
#   GDrive_work_CLIENT_ID=...
#   GDrive_work_CLIENT_SECRET=...
#   GDrive_work_REFRESH_TOKEN=...
# Users then pick the account per chat in /settings → ☁️ Drive account.
#
# Optional: pin all uploads inside one folder ID (applies to every account).
DRIVE_FOLDER_ID=

# Folder name on Drive where settings.json + IG indexes are stored.
# Defaults to "AzBotData".
DATA_DRIVE_FOLDER=AzBotData

# Optional: logging verbosity (DEBUG, INFO, WARNING, ERROR). Defaults to
# INFO. Logs go to both the console and data/logs/bot.log (rotated at 10MB,
# 3 backups kept).
LOG_LEVEL=INFO

# Optional: raw yt-dlp option overrides as a JSON object, merged on top of
# the bot's defaults. Same idea as WZML-X's YT_DLP_OPTIONS — lets you tweak
# yt-dlp behavior without touching code, e.g.:
# YT_DLP_OPTIONS={"writesubtitles": true, "subtitleslangs": ["en"]}
YT_DLP_OPTIONS=

# Optional: parallel MTProto media sessions for big uploads (bot-token-only).
# 1 = stock pyrogram behavior. Defaults 4 × 24-part window ≈ 12MB of
# in-flight buffers — the throughput lever with negligible RAM cost (the
# restarts came from Drive chunk buffers + ungated ffmpeg, both gated now).
# The BIGGEST Telegram speed factor is actually your api_id: public/shared
# api_ids get throttled hard by Telegram — create your own at
# my.telegram.org (free) and put it in .env (API_ID/API_HASH).
UPLOAD_SESSIONS=
# Optional: max unacknowledged 512KB parts in flight across all sessions.
UPLOAD_WINDOW=

# Optional: handler thread-pool size (default 16). Raise only if you share
# the bot among many chats and hit slowdowns during simultaneous probes.
HANDLER_WORKERS=

# Optional: concurrent download/upload JOBS (default 2, was hardcoded 4).
# Each active job runs its own subprocess (yt-dlp/aria2c/gallery-dl/ffmpeg)
# plus MTProto transfer buffers — on a low-RAM host this is the biggest
# peak-memory lever after UPLOAD_WORKERS. 2 keeps the queue responsive
# while halving worst-case concurrent load.
QUEUE_WORKERS=

# Optional: how many files upload concurrently per job (default 1 — the
# stable profile; 2 was reverted after an OOM restart on the low-RAM host
# during archiving). Each concurrent upload is another file's worth of
# transfer buffers plus its own ffmpeg/ffprobe subprocess calls — on a
# memory-constrained host this is a direct multiplier on PEAK memory, which
# is what actually triggers an out-of-memory kill. Raise only if your host
# has RAM headroom. Each file is still deleted the moment ITS upload
# finishes, regardless of concurrency.
UPLOAD_WORKERS=

# Optional: concurrent DRIVE uploads (default 1 = strictly serial, the
# safe profile). 2 doubles Drive-mirror throughput but re-enables the
# concurrent httplib2 resumable uploads that once corrupted the heap on
# this stack — set only if you accept that risk.
DRIVE_UPLOAD_CONCURRENCY=
