# =====================================================================
# 9router-azbot — Sevalla environment variables
# Fill values after "=", paste into Sevalla dashboard (or rename to .env
# for local runs). Lines starting with "#" are comments, ignored.
# Do NOT set PORT — Sevalla injects it automatically.
# Part 1 = variables only. Part 2 (below) = explanation + examples.
# =====================================================================

# ── Part 1: variables ──
API_ID=
API_HASH=
BOT_TOKEN=
INITIAL_PASSWORD=
ADMIN_ID=
GCP_CLIENT_ID=
GCP_CLIENT_SECRET=
GCP_REFRESH_TOKEN=
#GDrive_work_CLIENT_ID=
#GDrive_work_CLIENT_SECRET=
#GDrive_work_REFRESH_TOKEN=
DRIVE_FOLDER_ID=
DATA_DRIVE_FOLDER=AzBotData
GOOGLE_REDIRECT_URI=
QUEUE_WORKERS=
UPLOAD_WORKERS=
DRIVE_UPLOAD_CONCURRENCY=
HANDLER_WORKERS=
UPLOAD_SESSIONS=
UPLOAD_WINDOW=
YT_DLP_OPTIONS=
LOG_LEVEL=
DISABLE_TGCRYPTO=
TGCRYPTO_SELFTTEST=
JWT_SECRET=
ENABLE_REQUEST_LOGS=
SEARXNG_URL=
STREAM_STALL_TIMEOUT_MS=
STREAM_FIRST_CHUNK_TIMEOUT_MS=
FETCH_CONNECT_TIMEOUT_MS=
DEBUG=

# ── Part 2: what each variable does ────────────────────────────────
#
# REQUIRED — bot/dashboard won't start without these 4:
#
# API_ID / API_HASH — get free at https://my.telegram.org/apps (phone login >
#   API development tools > Create app). Pyrogram needs these even for a bot
#   account: direct MTProto access instead of the 50MB HTTP Bot API cap.
#   Example: API_ID=12345678
#            API_HASH=abcdef1234567890abcdef1234567890  (32 hex chars)
#
# BOT_TOKEN — from @BotFather (/newbot, copy token: digits, colon, ~35 chars).
#   Example: BOT_TOKEN=1234567890:AAHxYzAbC123dEfGhI456jKlMnO789
#   Missing = bot exits on boot, supervisor retries every 15s.
#
# INITIAL_PASSWORD — your 9Router web UI password (https://<app>.sevalla.app).
#   Upstream default 123456 — always set your own.
#   Example: INITIAL_PASSWORD=MyS3cret!Pass
#
# ACCESS:
#
# ADMIN_ID — your numeric Telegram ID (ask @userinfobot). Only this ID
#   (+ /allow list) may use the bot. Blank = anyone can use it.
#   Example: ADMIN_ID=206136283
#
# DRIVE (all blank = Drive features off):
#
# GCP_CLIENT_ID / GCP_CLIENT_SECRET / GCP_REFRESH_TOKEN — single-account
#   OAuth triple. Client pair from Google Cloud Console (APIs & Services >
#   Credentials > OAuth client ID, type Desktop); refresh token via local
#   gen_token.py run.
#   Example: GCP_CLIENT_ID=123456789-abc.apps.googleusercontent.com
#            GCP_CLIENT_SECRET=GOCSPX-AbCdEfGhIjKlMnOpQrSt
#            GCP_REFRESH_TOKEN=1//0gAbCdEfGhIjKlMnOpQrStUvWxYz...
#
# GDrive_<NAME>_CLIENT_ID / _CLIENT_SECRET / _REFRESH_TOKEN — multi-account:
#   same triple with any name (work, personal, 2); picked per chat in
#   /settings > Drive account. Names case-insensitive.
#   Example: GDrive_work_CLIENT_ID=123456789-abc.apps.googleusercontent.com
#            GDrive_work_CLIENT_SECRET=GOCSPX-AbCdEfGhIjKlMnOpQrSt
#            GDrive_work_REFRESH_TOKEN=1//0gAbCdEfGhIjKlMnOpQrStUvWxYz...
#
# DRIVE_FOLDER_ID — pin ALL Drive uploads inside one folder. Copy from the
#   Drive URL: drive.google.com/drive/folders/<ID>.
#   Example: DRIVE_FOLDER_ID=1AbCdEfGhIjKlMnOpQrStUvWxYz012345
#
# DATA_DRIVE_FOLDER — Drive folder holding settings.json + IG index files.
#   Auto-created. Example: DATA_DRIVE_FOLDER=AzBotData
#
# GOOGLE_REDIRECT_URI — OAuth redirect for local gen_token.py runs.
#   Default http://localhost:1/ works; change only if your Google client
#   demands a custom redirect.
#
# TUNING (image already sets low-RAM values; blank = image value; raise only
# with RAM headroom — peak memory is what OOM-kills small boxes):
#
# QUEUE_WORKERS (image 1, code default 2) — concurrent download+upload jobs,
#   each its own yt-dlp/aria2c/ffmpeg subprocess + MTProto buffers. Biggest
#   peak-memory lever. Example: QUEUE_WORKERS=2
#
# UPLOAD_WORKERS (image 1, code default 2) — concurrent uploads per job.
#   2 was reverted after an OOM restart on the low-RAM host. Each file
#   deletes right after ITS upload regardless. Example: UPLOAD_WORKERS=2
#
# DRIVE_UPLOAD_CONCURRENCY (image 1, code default 2) — parallel Drive
#   uploads. 2 doubles mirror speed; drop to 1 on instability.
#   Example: DRIVE_UPLOAD_CONCURRENCY=2
#
# HANDLER_WORKERS (image 8, code default 16) — message/button thread pool;
#   keeps taps responsive during slow yt-dlp probes. Raise for many chats.
#   Example: HANDLER_WORKERS=16
#
# UPLOAD_SESSIONS (default 4) — parallel MTProto sessions for files >10MB
#   (4 x 24-part window ~= 12MB in-flight; throughput lever, tiny RAM).
#   1 = stock pyrogram. Photos/webp or any failure auto-fall back.
#   Example: UPLOAD_SESSIONS=4
#
# UPLOAD_WINDOW (default 24) — max unacked 512KB parts in flight.
#   Example: UPLOAD_WINDOW=24
#
# YT_DLP_OPTIONS — raw yt-dlp overrides as JSON object, merged over bot
#   defaults (WZML-X style). Valid JSON, double quotes.
#   Example: YT_DLP_OPTIONS={"writesubtitles": true, "subtitleslangs": ["en"]}
#
# LOG_LEVEL — DEBUG / INFO / WARNING / ERROR; DEBUG very chatty.
#   Example: LOG_LEVEL=INFO
#
# DEBUG SWITCHES (leave blank):
#
# DISABLE_TGCRYPTO — 1 forces pure-Python crypto (~2-3x slower). Guard
#   self-tests native tgcrypto and falls back by itself normally.
#   Example: DISABLE_TGCRYPTO=1
#
# TGCRYPTO_SELFTTEST — internal self-test toggle (default 1). Leave blank.
#
# 9ROUTER:
#
# JWT_SECRET — signs dashboard login tokens. Auto-generated if unset; SET ONE
#   in production so logins survive restarts. Any long random string.
#   Example: JWT_SECRET=9f2c7a1e4b5d6f8091a2b3c4d5e6f7081a2b3c4d5e6f7081a2
#
# ENABLE_REQUEST_LOGS — true logs every proxied request/response. Very noisy;
#   on only when tracing a routing problem. Example: ENABLE_REQUEST_LOGS=true
#
# SEARXNG_URL — web-search backend; only if you run your own SearXNG.
#   Example: SEARXNG_URL=http://searxng:8888/search
#
# STREAM_STALL_TIMEOUT_MS (360000 = 6 min) — abort a flowing stream stalled
#   this long; generous so slow reasoning models survive.
# STREAM_FIRST_CHUNK_TIMEOUT_MS (200000) — abort if first token slower than
#   this (prefill). FETCH_CONNECT_TIMEOUT_MS (60000) — abort if upstream
#   sends no headers within this. Example: STREAM_STALL_TIMEOUT_MS=360000
#
# DEBUG — true = verbose 9Router logs. Example: DEBUG=true
#
# SUMMARY — one container, two apps (AzBot + 9Router). Minimum boot:
# API_ID, API_HASH, BOT_TOKEN, INITIAL_PASSWORD. Blank optionals = safe
# low-RAM defaults. No disk: chat settings + 9Router DB reset on redeploy,
# env values survive. Never commit real secrets; paste into Sevalla
# dashboard > Environment variables.
