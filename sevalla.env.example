# Copy these into the Sevalla dashboard (Environment variables). Never commit real values.
# Blank optional keys are safe — AzBot treats "" as unset.

# ── AzBot (required) ──────────────────────────────────────────────
# From https://my.telegram.org/apps — lets the bot use MTProto (no 50MB cap).
API_ID=
API_HASH=
# From @BotFather
BOT_TOKEN=
# Your numeric Telegram user ID (restricts bot to you + /allow list). Optional but recommended.
ADMIN_ID=

# ── 9Router (required) ────────────────────────────────────────────
# First-boot admin password for the 9Router web dashboard.
INITIAL_PASSWORD=

# ── AzBot Google Drive (optional) ─────────────────────────────────
# Single account style:
GCP_CLIENT_ID=
GCP_CLIENT_SECRET=
GCP_REFRESH_TOKEN=
# Pin all Drive uploads inside one folder ID (applies to every account).
DRIVE_FOLDER_ID=
DATA_DRIVE_FOLDER=AzBotData

# ── AzBot tuning (optional, low-RAM defaults already in image) ────
# QUEUE_WORKERS=1
# UPLOAD_WORKERS=1
# DRIVE_UPLOAD_CONCURRENCY=1
# HANDLER_WORKERS=8
# UPLOAD_SESSIONS=
# UPLOAD_WINDOW=
# LOG_LEVEL=INFO
# YT_DLP_OPTIONS=

# ── 9Router (optional) ────────────────────────────────────────────
# DATA_DIR=/app/data  (default in image; keep unless your disk mounts elsewhere)
# PORT is injected by Sevalla — do not set it yourself.
